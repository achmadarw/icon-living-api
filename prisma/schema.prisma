generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum Role {
  WARGA
  BENDAHARA
  KETUA
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentTypeCategory {
  IPL
  DONATION
  OTHER
}

enum NotificationType {
  PAYMENT_SUBMITTED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  EXPENSE_SUBMITTED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  EXPENSE_AUTO_APPROVED
  USER_CREATED
  ARREARS_WARNING
  WASTE_SUSPENSION_WARNING
  WASTE_SERVICE_RESTORED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum OccupancyStatus {
  PEMILIK
  KONTRAK
  KELUARGA
  LAINNYA
}

enum HomeCurrentStatus {
  DIHUNI
  KOSONG
  DISEWAKAN
  RENOVASI
  LAINNYA
}

enum VehicleType {
  MOBIL
  MOTOR
  SEPEDA
  LAINNYA
}

enum HouseholdStaffRole {
  ART
  SOPIR
  LAINNYA
}

// ─── Master Data ────────────────────────────────────────

model PaymentType {
  id          String   @id @default(cuid())
  name        String
  description String?
  fixedAmount Decimal? @db.Decimal(15, 2)
  isMandatory Boolean  @default(false)
  isActive    Boolean  @default(true)
  category    PaymentTypeCategory @default(IPL)
  requiresPeriod Boolean @default(true)

  payments Payment[]
  iplHouseholds Household[] @relation("HouseholdIplPaymentType")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_types")
}

model ExpenseCategory {
  id               String  @id @default(cuid())
  name             String
  description      String?
  requiresApproval Boolean @default(true)
  isActive         Boolean @default(true)

  expenses Expense[]
  budgets  CategoryBudget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("expense_categories")
}
// Frekuensi pembayaran anggaran kategori.
// - MONTHLY: tiap bulan (12 siklus per tahun)
// - BIMONTHLY: tiap 2 bulan (6 siklus per tahun) - mis. ganti oli
// - QUARTERLY: tiap 3 bulan (4 siklus per tahun) - mis. potong rumput
// - YEARLY: setahun sekali (1 siklus per tahun) - mis. THR
enum BudgetFrequency {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  YEARLY
}

// Anggaran kategori per tahun.
model CategoryBudget {
  id             String          @id @default(cuid())
  categoryId     String
  year           Int
  amountPerCycle Decimal         @db.Decimal(15, 2)
  frequency      BudgetFrequency @default(MONTHLY)
  note           String?

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, year])
  @@index([year])
  @@map("category_budgets")
}

enum MessageTemplateCategory {
  PENGUMUMAN
  TAGIHAN
  UPDATE_APLIKASI
  ACARA
  LAINNYA
}

// Template pesan WhatsApp yang tersimpan & bisa dipakai ulang saat broadcast.
// Terpisah dari proses pengiriman: template = konten reusable, broadcast = eksekusi.
model MessageTemplate {
  id            String                  @id @default(cuid())
  name          String
  category      MessageTemplateCategory @default(PENGUMUMAN)
  body          String
  // Daftar variabel custom yang dipakai template: [{ token, label, description }].
  variables     Json?
  // Penanda template bawaan sistem (mis. ARREARS_WARNING) agar idempoten & unik.
  systemKey     String?                 @unique
  createdById   String?
  createdByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("message_templates")
}


// ─── Core Models ────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  name         String
  username     String  @unique
  phone        String?
  passwordHash String
  role         Role    @default(WARGA)
  address      String?
  unitNumber   String? @unique
  avatarUrl    String?
  isActive     Boolean @default(true)
  householdId  String?
  isActivated  Boolean @default(false)
  activatedAt  DateTime?

  payments         Payment[]      @relation("PaymentSubmitter")
  reviewedPayments Payment[]      @relation("PaymentReviewer")
  requestedExpenses Expense[]     @relation("ExpenseRequester")
  approvedExpenses  Expense[]     @relation("ExpenseApprover")
  notifications    Notification[]
  refreshTokens    RefreshToken[]
  fcmTokens        FcmToken[]
  household        Household?      @relation(fields: [householdId], references: [id], onDelete: SetNull)
  activationOtps   AccountActivationOtp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("users")
}

model AccountActivationOtp {
  id                 String   @id @default(cuid())
  userId             String
  unitNumber         String
  otpHash            String
  expiresAt          DateTime
  attemptCount       Int      @default(0)
  resendCount        Int      @default(0)
  cooldownUntil      DateTime?
  consumedAt         DateTime?
  verifiedAt         DateTime?
  activationTokenHash String?
  activationTokenExpiresAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, unitNumber])
  @@index([unitNumber, consumedAt, expiresAt])
  @@map("account_activation_otps")
}

model Household {
  id                String            @id @default(cuid())
  unitNumber        String            @unique
  iplPaymentTypeId  String?
  occupancyStatus   OccupancyStatus?
  occupancyNote     String?
  homeCurrentStatus HomeCurrentStatus?
  homeStatusNote    String?
  residentCount     Int?
  emergencyContact  String?
  hobbies           String?
  consentGiven      Boolean?
  formSubmittedAt   DateTime?
  sourceRaw         Json?

  iplPaymentType    PaymentType?      @relation("HouseholdIplPaymentType", fields: [iplPaymentTypeId], references: [id], onDelete: SetNull)
  users             User[]
  members           HouseholdMember[]
  vehicles          HouseholdVehicle[]
  staff             HouseholdStaff[]
  emergencyContacts HouseholdEmergencyContact[]
  hobbiesDetail     HouseholdHobby[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("households")
  @@index([iplPaymentTypeId])
}

model HouseholdMember {
  id            String    @id @default(cuid())
  householdId   String
  name          String?
  age           Int?
  relationLabel String?
  isPrimary     Boolean   @default(false)
  notes         String?
  rawText       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_members")
}

model HouseholdVehicle {
  id          String      @id @default(cuid())
  householdId String
  type        VehicleType @default(LAINNYA)
  plateNumber String?
  color       String?
  description String?
  rawText     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_vehicles")
}

model HouseholdStaff {
  id          String             @id @default(cuid())
  householdId String
  name        String?
  role        HouseholdStaffRole @default(LAINNYA)
  isLiveIn    Boolean?
  description String?
  rawText     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_staff")
}

model HouseholdEmergencyContact {
  id          String   @id @default(cuid())
  householdId String
  name        String?
  phone       String?
  relation    String?
  priority    Int      @default(1)
  rawText     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_emergency_contacts")
}

model HouseholdHobby {
  id          String   @id @default(cuid())
  householdId String
  hobbyText   String
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_hobbies")
}

model FcmToken {
  id        String         @id @default(cuid())
  token     String         @unique
  platform  DevicePlatform
  userId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fcm_tokens")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Payment {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(15, 2) // Total = fixedAmount × jumlah periode (jika fixed)
  bankName      String
  accountName   String?
  transferDate  DateTime
  proofImageUrl String
  description   String?
  status        PaymentStatus @default(PENDING)
  reviewNote    String?
  reviewedAt    DateTime?

  userId        String
  paymentTypeId String
  reviewedById  String?

  user        User            @relation("PaymentSubmitter", fields: [userId], references: [id])
  paymentType PaymentType     @relation(fields: [paymentTypeId], references: [id])
  reviewedBy  User?           @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  periods     PaymentPeriod[] // Multi-periode: ["2026-01", "2026-02", ...]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([paymentTypeId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

// Junction table untuk multi-periode payment
model PaymentPeriod {
  id        String @id @default(cuid())
  period    String // Format: "2026-01"
  paymentId String

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, period])
  @@index([period])
  @@map("payment_periods")
}

model Expense {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(15, 2)
  description   String
  expenseDate   DateTime?
  paymentMethod String?
  recipient     String?
  referenceNumber String?
  attachmentUrl String?
  status        ExpenseStatus @default(DRAFT)
  approvalNote  String?
  approvedAt    DateTime?

  categoryId    String
  requestedById String
  approvedById  String?
  transactionId String?       @unique

  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  requestedBy User            @relation("ExpenseRequester", fields: [requestedById], references: [id])
  approvedBy  User?           @relation("ExpenseApprover", fields: [approvedById], references: [id])
  transaction Transaction?    @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([requestedById])
  @@index([status])
  @@index([createdAt])
  @@map("expenses")
}

// ─── Ledger ─────────────────────────────────────────────

model Transaction {
  id            String          @id @default(cuid())
  ledgerOrder   BigInt          @default(autoincrement()) @unique
  type          TransactionType
  amount        Decimal         @db.Decimal(15, 2)
  description   String
  balanceBefore Decimal         @db.Decimal(15, 2)
  balanceAfter  Decimal         @db.Decimal(15, 2)

  referenceId   String?
  referenceType String?         // "PAYMENT" atau "EXPENSE"

  expense Expense? // 1:1 with Expense only; Payment uses 1:N via referenceId

  createdAt DateTime @default(now())

  @@index([type])
  @@index([type, createdAt])
  @@index([ledgerOrder])
  @@index([createdAt])
  @@index([referenceType, type, createdAt])
  @@index([referenceType, referenceId])
  @@map("transactions")
}

// ─── Notifications ──────────────────────────────────────

model Notification {
  id            String           @id @default(cuid())
  type          NotificationType
  title         String
  message       String
  referenceId   String?
  referenceType String?
  isRead        Boolean          @default(false)
  readAt        DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─── Penagihan & Sanksi ─────────────────────────────────

// Catatan penghentian pengangkutan sampah untuk unit yang menunggak
// 2 bulan berturut-turut. Aktif sampai warga melunasi (auto-lift di Fase 2).
model WasteSuspension {
  id           String    @id @default(cuid())
  userId       String
  userName     String
  unitNumber   String?
  startPeriod  String // bulan berlaku, "YYYY-MM"
  reason       String?
  isActive     Boolean   @default(true)
  liftedAt     DateTime?
  liftedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([userId])
  @@map("waste_suspensions")
}

// Pengaturan singleton fitur penagihan otomatis (on/off + template pesan).
model ArrearsSetting {
  id                   String   @id @default("singleton")
  enabled              Boolean  @default(true)
  warningTemplateId    String?
  suspensionTemplateId String?
  updatedAt            DateTime @updatedAt

  @@map("arrears_settings")
}

// Log idempotency: mencegah peringatan tunggakan dobel untuk
// (warga, periode, tingkat) yang sama dalam satu bulan.
model ArrearsReminderLog {
  id       String   @id @default(cuid())
  userId   String
  period   String // bulan yang dievaluasi, "YYYY-MM"
  level    String // "WARNING" | "SUSPENSION"
  sentAt   DateTime @default(now())

  @@unique([userId, period, level])
  @@index([period])
  @@map("arrears_reminder_logs")
}

// Pelacakan status pengiriman WhatsApp per pesan (delivery report dari Fonnte).
model WhatsappDelivery {
  id           String   @id @default(cuid())
  fonnteId     String? // message id dari Fonnte (untuk dicocokkan webhook)
  stateId      String?
  target       String // nomor tujuan (dinormalisasi)
  userId       String?
  name         String?
  unitNumber   String?
  source       String // BROADCAST | ARREARS_WARNING | ARREARS_SUSPENSION | WASTE_RESTORED
  batchId      String? // pengelompokan satu kali broadcast
  status       String   @default("SENT") // PENDING | SENT | DELIVERED | READ | FAILED
  fonnteStatus String?
  fonnteState  String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([fonnteId])
  @@index([source, createdAt])
  @@map("whatsapp_deliveries")
}

// ─── Audit ──────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  userId    String
  oldData   Json?
  newData   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
